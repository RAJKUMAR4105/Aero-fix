# Copy this file to .env. Do not commit provider credentials.
# Without a key the app automatically uses the local MockLLM (grounded demo
# draft); set one of these (or AEROFIX_LLM_PROVIDER=mock) to control that.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

AEROFIX_LLM_PROVIDER=openai
AEROFIX_LLM_MODEL=gpt-4o
# Local embeddings: no API key needed for indexing or querying.
AEROFIX_EMBEDDING_PROVIDER=huggingface
AEROFIX_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
AEROFIX_RETRIEVAL_TOP_K=6
AEROFIX_CONFIDENCE_THRESHOLD=0.45
AEROFIX_CHROMA_DIR=.aerofix/chroma
AEROFIX_SQLITE_PATH=.aerofix/aerofix.sqlite
AEROFIX_CHECKPOINTER_PATH=.aerofix/checkpoints.sqlite

